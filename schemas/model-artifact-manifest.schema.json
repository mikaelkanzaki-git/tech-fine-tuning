{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-challenge.local/schemas/model-artifact-manifest-1.0.json",
  "title": "ModelArtifactManifest",
  "description": "Contrato de publicação entre tech-fine-tuning e tech-ai.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "artifact",
    "base_model",
    "tokenizer",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "enum": ["peft_adapter", "merged_transformers"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base_model": {
      "$ref": "#/$defs/versionedReference"
    },
    "tokenizer": {
      "$ref": "#/$defs/versionedReference"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producer_commit", "dataset_manifest_sha256"],
      "properties": {
        "producer": {
          "const": "tech-fine-tuning"
        },
        "producer_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}
